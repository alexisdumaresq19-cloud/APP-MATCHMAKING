{
  "name": "matchmaking-events",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:reset": "prisma migrate reset --force --skip-seed",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "create-org": "tsx --env-file-if-exists=.env scripts/create-org.ts",
    "billing:report": "tsx --env-file-if-exists=.env scripts/billing-report.ts",
    "prepare": "husky",
    "first-run": "tsx scripts/first-run.ts",
    "vercel-build": "tsx scripts/vercel-build.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@animated-color-icons/lucide-react": "1.0.0",
    "@base-ui/react": "^1.7.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/utilities": "^3.2.2",
    "@node-rs/argon2": "^2.2.0",
    "@prisma/client": "6.19.3",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.1.0",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "exceljs": "^4.4.0",
    "jose": "^6.2.10",
    "libphonenumber-js": "^1.13.12",
    "lucide-react": "^1.39.0",
    "motion": "^13.2.0",
    "next": "15.5.25",
    "next-auth": "5.0.0-beta.32",
    "next-themes": "^0.4.6",
    "nodemailer": "^9.1.1",
    "pino": "^10.3.1",
    "qrcode": "^1.5.4",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "resend": "^6.25.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.20.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.3.1",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@faker-js/faker": "^10.6.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22",
    "@types/nodemailer": "^8.0.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.25",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "prisma": "6.19.3",
    "tailwindcss": "^4",
    "tsx": "^4.20.0",
    "typescript": "^5",
    "vitest": "^4.1.11"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "esbuild",
      "unrs-resolver",
      "@node-rs/argon2"
    ],
    "overrides": {
      "postcss@<8.5.18": ">=8.5.18",
      "deepmerge-ts@<8.0.0": ">=8.0.0"
    },
    "peerDependencyRules": {
      "allowedVersions": {
        "@auth/core>nodemailer": "9"
      }
    }
  }
}
